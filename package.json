{
  "name": "manili-shop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MANILI — fashion brand + e-commerce",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "check:deps": "node scripts/check-imports.mjs",
    "setup:appwrite": "node scripts/setup-appwrite.mjs",
    "functions:build": "node scripts/prepare-functions.mjs",
    "seed:appwrite": "node scripts/seed-appwrite.mjs",
    "telegram:register": "node scripts/register-telegram-webhook.mjs",
    "brand:images": "node scripts/generate-brand-images.mjs"
  },
  "dependencies": {
    "appwrite": "^16.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "node-appwrite": "^14.2.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}

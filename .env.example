# ==========================================================================
# MANILI — ПРИМЕР ПЕРЕМЕННЫХ ОКРУЖЕНИЯ
#
# Скопируйте в .env и заполните. .env в git НЕ попадает (см. .gitignore).
#
# ВАЖНО: всё, что начинается с VITE_, попадает в браузер и видно любому
# посетителю. Секретов там быть не может. Ключи платёжной системы, Telegram,
# доставки и почты задаются ТОЛЬКО в переменных окружения серверных функций
# Appwrite (раздел ниже) — ТЗ §32, §47.
# ==========================================================================

# --- FRONTEND (публичные значения) ---------------------------------------

# mock — демо-данные в браузере, работает без backend
# appwrite — боевой режим
VITE_BACKEND=mock

# Публичные идентификаторы Appwrite. Это не секреты.
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=manili
VITE_APPWRITE_BUCKET_ID=media

# Базовый URL серверных функций, если они вынесены за пределы Appwrite SDK
VITE_API_BASE_URL=

# Домен и контакты магазина
VITE_SITE_URL=https://manili-event.ru
VITE_SUPPORT_EMAIL=hello@manili-event.ru
VITE_SUPPORT_PHONE=+7 999 000-00-00

# Соцсети и маркетплейсы (пустые — блок не показывается)
VITE_SOCIAL_TELEGRAM=
VITE_SOCIAL_VK=
VITE_SOCIAL_INSTAGRAM=
VITE_MARKETPLACE_WB=
VITE_MARKETPLACE_OZON=

# Базовый путь сборки: '/' для своего домена, '/shop/' для github.io/<repo>/
VITE_BASE_PATH=/


# ==========================================================================
# SERVER-SIDE — задаётся в настройках функций Appwrite.
# Эти значения НИКОГДА не попадают в браузер и не коммитятся.
# ==========================================================================

# --- Appwrite ------------------------------------------------------------
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=manili
SITE_URL=https://manili-event.ru

# --- Платежи (ТЗ §15): yookassa | tbank ----------------------------------
PAYMENT_PROVIDER=
PAYMENT_SHOP_ID=
PAYMENT_SECRET=
# Чеки 54-ФЗ: 1 — включить
PAYMENT_RECEIPTS=0
PAYMENT_VAT_CODE=1

# --- Доставка (ТЗ §16): cdek | пусто — базовые тарифы --------------------
DELIVERY_PROVIDER=
DELIVERY_ACCOUNT=
DELIVERY_API_KEY=
DELIVERY_FROM_CITY_CODE=44
# Тарифы, когда служба не подключена (в копейках)
DELIVERY_PRICE_PVZ=35000
DELIVERY_PRICE_COURIER=45000
DELIVERY_PRICE_POST=30000
DELIVERY_SELF_PICKUP_ADDRESS=

# Бесплатная доставка от суммы, в копейках (10 000 ₽)
FREE_DELIVERY_THRESHOLD=1000000

# --- Telegram владельцу (ТЗ §21) -----------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# --- Email (ТЗ §22, §23) -------------------------------------------------
EMAIL_API_KEY=
EMAIL_API_URL=
EMAIL_FROM=
EMAIL_FROM_NAME=MANILI
# Копия каждого нового заказа владельцу
EMAIL_OWNER=

# --- SMS для входа по телефону (ТЗ §6) -----------------------------------
SMS_API_KEY=

# --- Нумерация заказов ---------------------------------------------------
ORDER_NUMBER_START=1041
